  - m_Id: 343984059703422
    m_Localized: 'Defeat Queen Minos. Unlocks: rerolls in the Gates of Hell menu.'
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703423
    m_Localized: 'Rescue Horace. Unlocks: Horace''s Blessing.'
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703424
    m_Localized: 'Rescue Homer. Unlocks: Homer''s Blessing.'
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703425
    m_Localized: 'Use Blazing Quill in Limbo twice. Unlocks: Virgil''s Blessing.'
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703426
    m_Localized: Survive 12 minutes in Circle 1, Limbo.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703427
    m_Localized: Survive 12 minutes in Circle 2, Lust.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703428
    m_Localized: 'Defeat Libicocco and Scarmiglione. Unlocks: banish in the Gates
      of Hell menu.'
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703429
    m_Localized: Defeat Scarmiglione in Circle 2, Lust.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703430
    m_Localized: 'Rescue Ovid. Unlocks: Ovid''s Blessing.'
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703431
    m_Localized: 'Defeat Queen Minos three separate times. Unlocks: Minos'' Taboo
      Arts.'
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703432
    m_Localized: 'Defeat Libicocco and Scarmiglione three separate times. Unlocks:
      Libocco''s and Scarmiglione''s Taboo Arts.'
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703433
    m_Localized: Kill 2000 Brotchi enemies.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703434
    m_Localized: Reach Level 50.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703435
    m_Localized: Reach Level 75.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703436
    m_Localized: Level up a Charm to Level 9.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703437
    m_Localized: Get a Charm of Crystal rarity.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703438
    m_Localized: Deal 200.000 damage with a single weapon in a single run.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703439
    m_Localized: Reach a high-score of 100.000 in Circle 1, Limbo.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703440
    m_Localized: Reach a high-score of 100.000 in Circle 2, Lust.
    m_Metadata:
      m_Items: []
