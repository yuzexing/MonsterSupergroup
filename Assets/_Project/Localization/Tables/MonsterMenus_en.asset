  - m_Id: 343984059703452
    m_Localized: Equip all of Ovid's Mod cards.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703453
    m_Localized: Equip three Level 3 Mod cards onto a single Weapon card.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703454
    m_Localized: Get a full hand of Level 3 Mod cards in a single run.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703455
    m_Localized: Kill 2500 enemies in a single run.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703456
    m_Localized: Activate all available Temple types.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703457
    m_Localized: Activate 12 different Temples in a single run.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703458
    m_Localized: Beat Circle 1, Limbo, without healing more than 500 HP.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703459
    m_Localized: Beat Circle 2, Lust, without healing more than 500 HP.
    m_Metadata:
      m_Items: []
