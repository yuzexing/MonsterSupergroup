    m_Localized: Equip all of Virgil's Weapon cards.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703446
    m_Localized: Equip all of Virgil's Mod cards.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703447
    m_Localized: Equip all of Horace's Weapon cards.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703448
    m_Localized: Equip all of Horace's Mod cards.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703449
    m_Localized: Equip all of Homer's Weapon cards.
    m_Metadata:
      m_Items: []
  - m_Id: 343984059703450
    m_Localized: Equip all of Homer's Mod cards.
    m_Metadata:
      m_Items: []
