  - m_Id: 343984055509360
    m_Localized: "\u300AHell Maiden\u300B\u76EE\u524D\u5904\u4E8E\u62A2\u5148\u4F53\u9A8C\u9636\u6BB5\uFF0C\u5E76\u5C06\u6839\u636E\u60A8\u7684\u53CD\u9988\u6301\u7EED\u8FDB\u884C\u66F4\u65B0\u4E0E\u4F18\u5316\u3002\n\n\u968F\u7740\u5F00\u53D1\u4E0D\u65AD\u63A8\u8FDB\uFF0C\u6211\u4EEC\u5C06\u52A0\u5165\u5168\u65B0\u7684\u5173\u5361\u3001\u89D2\u8272\u3001\u5361\u724C\u3001Boss
      \u6218\u4EE5\u53CA\u5267\u60C5\u4E8B\u4EF6\uFF0C\u540C\u65F6\u8FDB\u4E00\u6B65\u5B8C\u5584\u6574\u4F53\u6E38\u620F\u4F53\u9A8C\u3002\n\n\u795D\u60A8\u5728\u5730\u72F1\u6DF1\u6E0A\u7684\u5192\u9669\u4E2D\u73A9\u5F97\u6109\u5FEB\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 343984055509361
    m_Localized: "\u611F\u8C22\u6E38\u73A9\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 343984055509362
    m_Localized: "\u60A8\u5DF2\u5B8C\u6210\u5F53\u524D\u62A2\u5148\u4F53\u9A8C\u7248\u672C\u7684\u4E3B\u7EBF\u5267\u60C5\u4E0E\u6210\u957F\u8FDB\u5EA6\u3002\n\n\u4E0D\u8FC7\uFF0C\u6E38\u620F\u4E2D\u4ECD\u6709\u66F4\u591A\u5185\u5BB9\u7B49\u5F85\u63A2\u7D22\uFF0C\u8FD8\u6709\u53EF\u89E3\u9501\u8981\u7D20\u3001\u89D2\u8272\u4E92\u52A8\uFF0C\u4EE5\u53CA\u6570\u5341\u79CD\u4E0D\u540C\u7684\u6D41\u6D3E\u7EC4\u5408\u53EF\u4F9B\u5C1D\u8BD5\u3002\u5E0C\u671B\u60A8\u80FD\u5C3D\u60C5\u4F53\u9A8C
      Hell Maiden EA 1.0 \u6240\u5E26\u6765\u7684\u4E50\u8DA3\uFF01\n\n\u60A8\u7684\u652F\u6301\u5BF9\u6211\u4EEC\u610F\u4E49\u91CD\u5927\uFF0C\u4E5F\u5E0C\u671B\u60A8\u80FD\u901A\u8FC7\u5728
      Steam \u4E0A\u7559\u4E0B\u53CD\u9988\u548C\u8BC4\u6D4B\uFF0C\u53C2\u4E0E\u6211\u4EEC\u7684\u5F00\u53D1\u8FC7\u7A0B\u3002"
